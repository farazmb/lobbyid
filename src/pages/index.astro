</style>

<script is:inline>
  (() => {
    const searchInput = document.getElementById("nameSearch");
    const categoryButtons = document.querySelectorAll("[data-filter]");
    const cards = Array.from(document.querySelectorAll(".name-card"));
    const itemCount = document.getElementById("itemCount");
    const emptyState = document.getElementById("emptyState");
    const nameGrid = document.getElementById("nameGrid");
    const toast = document.getElementById("toast");
    const randomButton = document.getElementById("randomButton");
    const clearSearch = document.getElementById("clearSearch");

    let activeCategory = "all";
    let toastTimeout;

    function showToast(message) {
      toast.textContent = message;
      toast.classList.add("visible");

      window.clearTimeout(toastTimeout);
      toastTimeout = window.setTimeout(() => {
        toast.classList.remove("visible");
      }, 1800);
    }

    function filterNames() {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesCategory =
          activeCategory === "all" ||
          card.dataset.category === activeCategory;

        const matchesSearch =
          (card.dataset.name || "").includes(query);

        const visible = matchesCategory && matchesSearch;
        card.hidden = !visible;

        if (visible) visibleCount++;
      });

      itemCount.textContent = `${visibleCount} ITEMS`;
      emptyState.hidden = visibleCount !== 0;
      nameGrid.hidden = visibleCount === 0;
    }

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.filter || "all";

        categoryButtons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle("active", isActive);
          item.setAttribute("aria-pressed", String(isActive));
        });

        filterNames();
      });
    });

    searchInput.addEventListener("input", filterNames);

    document.querySelectorAll("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const name = button.dataset.copy || "";
        const originalText = button.querySelector("span").textContent;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(name);
          } else {
            const textArea = document.createElement("textarea");
            textArea.value = name;
            textArea.style.position = "fixed";
            textArea.style.opacity = "0";
            document.body.appendChild(textArea);
            textArea.select();

            const copied = document.execCommand("copy");
            textArea.remove();

            if (!copied) throw new Error("Copy failed");
          }

          button.classList.add("copied");
          button.querySelector("span").textContent = "COPIED";
          showToast(`COPIED: ${name}`);

          window.setTimeout(() => {
            button.classList.remove("copied");
            button.querySelector("span").textContent = originalText;
          }, 1200);
        } catch {
          showToast("Copy failed. Please select the name manually.");
        }
      });
    });

    randomButton.addEventListener("click", async () => {
      const visibleCards = cards.filter((card) => !card.hidden);

      if (visibleCards.length === 0) {
        showToast("No names available. Try another filter.");
        return;
      }

      const selected =
        visibleCards[Math.floor(Math.random() * visibleCards.length)];

      const copyButton = selected.querySelector("[data-copy]");
      if (copyButton) copyButton.click();
    });

    clearSearch.addEventListener("click", () => {
      searchInput.value = "";
      activeCategory = "all";

      categoryButtons.forEach((button) => {
        const isActive = button.dataset.filter === "all";
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });

      filterNames();
    });

    filterNames();
  })();
</script>
